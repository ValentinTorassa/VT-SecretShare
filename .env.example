# Copy to .env and load with `set -a; . ./.env; set +a` (or use docker-compose).
PORT=8080
# Host port published by docker compose.
APP_PORT=8080
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
# Public base URL used to build share links (set this when behind Tailscale/Nginx).
BASE_URL=http://localhost:8080
# Limits
MAX_CIPHERTEXT_BYTES=262144
DEFAULT_TTL_SECONDS=86400
MAX_TTL_SECONDS=604800
# Rate limits per client IP, counted in Redis (0 disables a limiter).
RATE_LIMIT_CREATE=20
RATE_LIMIT_CREATE_WINDOW_SECONDS=600
RATE_LIMIT_READ=30
RATE_LIMIT_READ_WINDOW_SECONDS=600
# HMAC key for rate-limit counter keys (no raw IPs in Redis). Generate with
# `openssl rand -hex 32` and keep it out of git. Empty = random per process,
# so counters reset on restart.
RATE_LIMIT_SALT=
# Peers whose CF-Connecting-IP header is trusted (cloudflared on localhost).
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
